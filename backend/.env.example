NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/uploads
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

AWS_REGION=ap-southeast-1
S3_BUCKET=my-private-upload-bucket
# S3_ENDPOINT=http://localhost:9000        # MinIO / LocalStack
# S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=private-uploads

# 50 GiB
MAX_FILE_SIZE_BYTES=53687091200
DEFAULT_QUOTA_BYTES=53687091200
# 128 MiB
DEFAULT_PART_SIZE_BYTES=134217728
PRESIGN_TTL_SECONDS=900
SESSION_TTL_SECONDS=86400
MAX_ACTIVE_UPLOADS_PER_USER=3
MAX_PRESIGN_BATCH=50
COMPLETING_LEASE_SECONDS=120
ALLOWED_CONTENT_TYPE_PREFIXES=video/,audio/

# Run the maintenance worker inside the API process (use a separate `npm run start:worker` in prod if you scale API pods)
ENABLE_EMBEDDED_WORKER=true
WORKER_INTERVAL_MS=30000
WORKER_BATCH_SIZE=20
